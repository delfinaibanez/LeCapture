---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import retrato from '../assets/images/sobre-mi/retrato.jpg';
import CTAFinal from '../components/CTAFinal.astro';

// Detrás de cámara: toma automáticamente TODAS las fotos de la carpeta, ordenadas por nombre
const detrasCamaraModules = import.meta.glob('../assets/images/sobre-mi/detras-camara/*.{jpeg,jpg,png,webp}', { eager: true });
const detrasCamaraImages = Object.keys(detrasCamaraModules)
  .sort()
  .map((key) => (detrasCamaraModules[key] as any).default);

// Toma automáticamente TODAS las fotos de la carpeta estudio, ordenadas por nombre
const estudioModules = import.meta.glob('../assets/images/sobre-mi/estudio/*.{jpeg,jpg,png,webp}', { eager: true });
const estudioImages = Object.keys(estudioModules)
  .sort()
  .map((key) => (estudioModules[key] as any).default);
---

<Layout title="Sobre mí">

   <!-- INTRO -->
  <section class="w-full py-14 md:py-24 px-6" style="background-color: #EFE9E3;">
    <div class="max-w-5xl mx-auto flex flex-col md:flex-row items-center md:items-start gap-8 md:gap-16">

      <!-- Foto vertical con proporción fija + tarjetita -->
      <div class="relative w-60 md:w-[26rem] shrink-0 mx-auto md:mx-0">
        <div class="aspect-[3/4] rounded-[1.75rem] md:rounded-[2rem] overflow-hidden shadow-lg">
          <Image
            src={retrato}
            alt="Fotógrafa de LeCapture"
            width={500}
            height={650}
            format="webp"
            quality={85}
            loading="eager"
            class="w-full h-full object-cover"
          />
        </div>
        <div class="absolute -bottom-3 -right-3 md:-bottom-4 md:-right-4 rounded-xl md:rounded-2xl px-3 py-2 md:px-4 md:py-2.5 shadow-md rotate-[-4deg] text-center" style="background-color: #F9F8F6; border: 1px solid rgba(61,58,54,0.15);">
          <p class="font-bold text-base md:text-lg leading-none" style="color: #3D3A36;">+500</p>
          <p class="text-[10px] md:text-xs flex items-center justify-center gap-1" style="color: rgba(61,58,54,0.7);">
            familias felices
          </p>
        </div>
      </div>

      <!-- Texto -->
      <div class="text-center md:text-left md:pt-4 px-2 md:px-0">
        <p class="text-xs md:text-sm font-semibold tracking-widest uppercase mb-2" style="color: #7A756D;">
          Conóceme
        </p>
        <h1 class="font-script text-3xl md:text-5xl font-normal mb-4 md:mb-5" style="color: #3D3A36;">
          Hola, soy Candela
        </h1>
        <p class="leading-relaxed mb-4 max-w-md mx-auto md:mx-0 text-sm md:text-base" style="color: rgba(61,58,54,0.8);">
          Mi cámara y yo somos inseparables desde hace más de una década. Con más de 500 familias y bebés retratados —y una formación en España que me llevó a recorrer distintos rincones de Europa—, volví mi pasión un oficio.
        </p>

        <!-- En mobile, segundo párrafo colapsable para no saturar la pantalla -->
        <details class="md:hidden group text-left max-w-md mx-auto">
          <summary class="list-none flex items-center justify-center gap-1 text-sm font-semibold cursor-pointer mb-2" style="color: #3D3A36;">
            Seguir leyendo
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0 transition-transform group-open:rotate-180"><path d="m6 9 6 6 6-6"/></svg>
          </summary>
          <p class="leading-relaxed text-sm mb-2" style="color: rgba(61,58,54,0.8);">
            Busco la armonía y la belleza en cada rincón, cuidando los colores, las texturas y los pequeños detalles cotidianos para que cada imagen tenga su propia magia.
          </p>
          <p class="leading-relaxed text-sm" style="color: rgba(61,58,54,0.8);">
            Me encanta crear con mis propias manos: diseño, decoro y armo cada escenografía para que tu sesión sea irrepetible. Detrás de cada toma hay mucho más que técnica; hay horas de dedicación, sensibilidad estética y el deseo genuino de que tus recuerdos reflejen la belleza y autenticidad de tu historia.
          </p>
        </details>

        <!-- En desktop, todo el texto visible sin colapsar -->
        <p class="hidden md:block leading-relaxed mb-4 max-w-md" style="color: rgba(61,58,54,0.8);">
          Busco la armonía y la belleza en cada rincón, cuidando los colores, las texturas y los pequeños detalles cotidianos para que cada imagen tenga su propia magia.
        </p>
        <p class="hidden md:block leading-relaxed max-w-md" style="color: rgba(61,58,54,0.8);">
          Me encanta crear con mis propias manos: diseño, decoro y armo cada escenografía para que tu sesión sea irrepetible. Detrás de cada toma hay mucho más que técnica; hay horas de dedicación, sensibilidad estética y el deseo genuino de que tus recuerdos reflejen la belleza y autenticidad de tu historia.
        </p>

      </div>

    </div>
  </section>

  <!-- DETRÁS DE CÁMARA -->
  <section class="w-full py-16 md:py-24 px-6" style="background-color: #EFE9E3;">
    <div class="max-w-5xl mx-auto">

      <p class="text-xs md:text-sm font-semibold tracking-widest uppercase text-center mb-2" style="color: #7A756D;">
        Mi trabajo
      </p>
      <h2 class="text-2xl md:text-4xl font-semibold text-center mb-4" style="color: #3D3A36;">
        Detrás de cámara
      </h2>
      <p class="text-center max-w-lg mx-auto mb-12 md:mb-16" style="color: rgba(61,58,54,0.8);">
      Paciencia, juego y momentos espontáneos: la verdadera receta detrás de cada risa y cada recuerdo.
      </p>

         <!-- MOBILE: carrusel horizontal -->
      <div class="md:hidden relative -mx-6 px-6">
        <div
          id="detras-scroll"
          class="flex gap-4 overflow-x-auto snap-x snap-mandatory pb-4 scrollbar-hide"
        >
          {detrasCamaraImages.map((foto, i) => (
            <div class="snap-center shrink-0 w-[72vw] max-w-72 aspect-[3/4] rounded-[1.5rem] overflow-hidden shadow-md">
              <Image
                src={foto}
                alt={`Detrás de cámara - imagen ${i + 1}`}
                width={500}
                height={650}
                format="webp"
                quality={85}
                loading="lazy"
                class="w-full h-full object-cover"
              />
            </div>
          ))}
        </div>

        <!-- Degradados en los bordes -->
        <div class="pointer-events-none absolute top-0 left-0 h-[calc(100%-1rem)] w-10 bg-gradient-to-r from-[#EFE9E3] to-transparent"></div>
        <div class="pointer-events-none absolute top-0 right-0 h-[calc(100%-1rem)] w-10 bg-gradient-to-l from-[#EFE9E3] to-transparent"></div>
      </div>
       <!-- DESKTOP: carrusel deslizante -->
      <div class="hidden md:block relative overflow-hidden">
        <div
          id="detras-track"
          class="flex gap-4 pb-4 transition-transform duration-700 ease-[cubic-bezier(0.65,0,0.35,1)]"
        >
          {detrasCamaraImages.map((foto, i) => (
            <div class="shrink-0 w-56 aspect-square rounded-[1.5rem] overflow-hidden shadow-md group">
              <Image
                src={foto}
                alt={`Detrás de cámara - imagen ${i + 1}`}
                width={400}
                height={400}
                format="webp"
                quality={85}
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
              />
            </div>
          ))}
        </div>

        <div class="pointer-events-none absolute top-0 left-0 h-[calc(100%-1rem)] w-16 bg-gradient-to-r from-[#EFE9E3] via-[#EFE9E3]/70 to-transparent"></div>
        <div class="pointer-events-none absolute top-0 right-0 h-[calc(100%-1rem)] w-16 bg-gradient-to-l from-[#EFE9E3] via-[#EFE9E3]/70 to-transparent"></div>

        <button
          id="detras-prev"
          aria-label="Ver anterior"
          class="absolute left-0 top-1/2 -translate-y-1/2 text-4xl leading-none px-2 transition-colors"
          style="color: rgba(61,58,54,0.5);"
        >
          ‹
        </button>
        <button
          id="detras-next"
          aria-label="Ver siguiente"
          class="absolute right-0 top-1/2 -translate-y-1/2 text-4xl leading-none px-2 transition-colors"
          style="color: rgba(61,58,54,0.5);"
        >
          ›
        </button>
      </div>

    </div>
  </section>

  <script>
    const detrasTrack = document.getElementById('detras-track');
    const detrasNextBtn = document.getElementById('detras-next');
    const detrasPrevBtn = document.getElementById('detras-prev');

    let detrasIndex = 0;
    const detrasGap = 16; // gap-4

    function getDetrasCardWidth() {
      const card = detrasTrack?.querySelector('div') as HTMLElement | null;
      return card ? card.offsetWidth + detrasGap : 0;
    }

    function detrasMaxIndex() {
      if (!detrasTrack) return 0;
      const cardCount = detrasTrack.children.length;
      const visible = Math.floor((detrasTrack.parentElement!.offsetWidth) / getDetrasCardWidth());
      return Math.max(cardCount - visible, 0);
    }

    function detrasUpdate() {
      if (!detrasTrack) return;
      const offset = detrasIndex * getDetrasCardWidth();
      detrasTrack.style.transform = `translateX(-${offset}px)`;
    }

    detrasNextBtn?.addEventListener('click', () => {
      detrasIndex = Math.min(detrasIndex + 1, detrasMaxIndex());
      detrasUpdate();
    });

    detrasPrevBtn?.addEventListener('click', () => {
      detrasIndex = Math.max(detrasIndex - 1, 0);
      detrasUpdate();
    });

    window.addEventListener('resize', detrasUpdate);
  </script>

  <!-- EL ESTUDIO -->
  <section class="w-full py-16 md:py-24 px-6" style="background-color: #F9F8F6;">
    <div class="max-w-5xl mx-auto">

      <p class="text-xs md:text-sm font-semibold tracking-widest uppercase text-center mb-2" style="color: #7A756D;">
        El espacio
      </p>
      <h2 class="text-2xl md:text-4xl font-semibold text-center mb-4" style="color: #3D3A36;">
        Conocé el estudio
      </h2>
      <p class="text-center max-w-lg mx-auto mb-12 md:mb-16" style="color: rgba(61,58,54,0.8);">
        Un espacio creado y pensado desde el amor para que vos y tu familia se sientan como en casa, rodeados de comodidad y calidez.
      </p>

      <!-- MOBILE: carrusel horizontal -->
      <div class="md:hidden relative -mx-6 px-6">
        <div
          id="estudio-scroll-mobile"
          class="flex gap-4 overflow-x-auto snap-x snap-mandatory pb-4 scrollbar-hide"
        >
          {estudioImages.map((foto, i) => (
            <div class="snap-center shrink-0 w-[78vw] max-w-80 aspect-[4/3] rounded-[1.5rem] overflow-hidden shadow-md">
              <Image
                src={foto}
                alt={`Estudio de fotografía - imagen ${i + 1}`}
                width={500}
                height={380}
                format="webp"
                quality={85}
                loading="lazy"
                class="w-full h-full object-cover"
              />
            </div>
          ))}
        </div>

        <div class="pointer-events-none absolute top-0 left-0 h-[calc(100%-1rem)] w-10 bg-gradient-to-r from-[#F9F8F6] to-transparent"></div>
        <div class="pointer-events-none absolute top-0 right-0 h-[calc(100%-1rem)] w-10 bg-gradient-to-l from-[#F9F8F6] to-transparent"></div>
      </div>

      <!-- DESKTOP: carrusel con flechas -->
      <div class="hidden md:block relative overflow-hidden">
        <div
          id="estudio-track"
          class="flex gap-5 pb-4 transition-transform duration-700 ease-[cubic-bezier(0.65,0,0.35,1)]"
        >
         {estudioImages.map((foto, i) => (
            <div class="shrink-0 w-72 md:w-96 rounded-[1.5rem] overflow-hidden shadow-md group">
              <Image
                src={foto}
                alt={`Estudio de fotografía - imagen ${i + 1}`}
                width={500}
                height={380}
                format="webp"
                quality={85}
                loading="lazy"
                class="w-full h-64 md:h-80 object-cover group-hover:scale-110 transition-transform duration-500"
              />
            </div>
          ))}   
        </div>

        <div class="pointer-events-none absolute top-0 left-0 h-[calc(100%-1rem)] w-16 bg-gradient-to-r from-[#F9F8F6] via-[#F9F8F6]/70 to-transparent"></div>
        <div class="pointer-events-none absolute top-0 right-0 h-[calc(100%-1rem)] w-16 bg-gradient-to-l from-[#F9F8F6] via-[#F9F8F6]/70 to-transparent"></div>

        <button
          id="estudio-prev"
          aria-label="Ver anterior"
          class="absolute left-0 top-1/2 -translate-y-1/2 text-4xl leading-none px-2 transition-colors"
          style="color: rgba(61,58,54,0.5);"
        >
          ‹
        </button>
        <button
          id="estudio-next"
          aria-label="Ver siguiente"
          class="absolute right-0 top-1/2 -translate-y-1/2 text-4xl leading-none px-2 transition-colors"
          style="color: rgba(61,58,54,0.5);"
        >
          ›
        </button>
      </div>

    </div>
  </section>

  <script>
    const track = document.getElementById('estudio-track');
    const nextBtn = document.getElementById('estudio-next');
    const prevBtn = document.getElementById('estudio-prev');

    let index = 0;
    const gap = 20; // gap-5

    function getCardWidth() {
      const card = track?.querySelector('div') as HTMLElement | null;
      return card ? card.offsetWidth + gap : 0;
    }

    function maxIndex() {
      if (!track) return 0;
      const cardCount = track.children.length;
      const visible = Math.floor((track.parentElement!.offsetWidth) / getCardWidth());
      return Math.max(cardCount - visible, 0);
    }

    function update() {
      if (!track) return;
      const offset = index * getCardWidth();
      track.style.transform = `translateX(-${offset}px)`;
    }

    nextBtn?.addEventListener('click', () => {
      index = Math.min(index + 1, maxIndex());
      update();
    });

    prevBtn?.addEventListener('click', () => {
      index = Math.max(index - 1, 0);
      update();
    });

    window.addEventListener('resize', update);
  </script>

  <!-- CTA FINAL -->
  <CTAFinal />

</Layout>
---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import CTAFinal from '../../components/CTAFinal.astro';
import SesionCarrusel from '../../components/SesionCarrusel.astro';

export async function getStaticPaths() {
  const sesiones = await getCollection('sesionesFijas');
  return sesiones.map((sesion) => ({
    params: { slug: sesion.data.slug },
    props: { sesion },
  }));
}

const { sesion } = Astro.props;
const { titulo, descripcion, imagenHero, packs, faqs } = sesion.data;

// Fotos de la sesión: toma todas las carpetas de sesiones y filtra por el slug actual.
// Se normalizan guiones medios/bajos para que "recien-nacido" y "recien_nacido" matcheen igual,
// así cada sesión puede tener una cantidad distinta de fotos sin depender de que el nombre
// de carpeta sea carácter por carácter idéntico al slug.
function normalizar(str: string) {
  return str
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '') // saca acentos (é -> e, ñ -> n, etc.)
    .replace(/[-_]/g, '');
}

const fotosModules = import.meta.glob('../../assets/images/sesiones/*/*.{jpeg,jpg,png,webp}', { eager: true });
const fotosSesion = Object.keys(fotosModules)
  .filter((key) => {
    const match = key.match(/\/sesiones\/([^/]+)\//);
    return match && normalizar(match[1]) === normalizar(sesion.data.slug);
  })
  .sort()
  .map((key) => (fotosModules[key] as any).default);

// Paleta para cada pack: fondo de la tarjeta, color del check, fondo del botón y color de texto del botón
const paletaPacks = [
  { bg: '#F9F8F6', texto: '#6b4a3f', check: '#D9CFC7', boton: '#D9CFC7', botonTexto: '#6b4a3f' },
  { bg: '#D9CFC7', texto: '#6b4a3f', check: '#F9F8F6', boton: '#F9F8F6', botonTexto: '#6b4a3f' },
  { bg: '#EFE9E3', texto: '#6b4a3f', check: '#D9CFC7', boton: '#D9CFC7', botonTexto: '#6b4a3f' },
];
---

<Layout title={titulo}>

  <!-- HERO -->
  <section class="relative w-full h-[55vh] md:h-[65vh] overflow-hidden">
    <Image
      src={imagenHero}
      alt={titulo}
      width={1600}
      height={1000}
      format="webp"
      quality={85}
      loading="eager"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-choco/80 via-choco/20 to-transparent"></div>
    <div class="absolute inset-x-0 bottom-0 h-24 md:h-32 bg-gradient-to-t from-[#EFE9E3]/25 to-transparent"></div>
    <div class="absolute inset-0 flex flex-col items-center justify-end text-center px-6 pb-12 md:pb-16">
      <h1 class="font-script text-4xl md:text-6xl font-normal text-cream mb-4 drop-shadow-md">
        {titulo}
      </h1>
      <p class="text-cream/90 text-sm md:text-base max-w-xl leading-relaxed drop-shadow-md">
        {descripcion}
      </p>
    </div>
  </section>

  <!-- FOTOS DE LA SESIÓN -->
  {fotosSesion.length > 0 && (
    <section class="w-full py-14 md:py-20 px-6" style="background-color: #F9F8F6;">
      <div class="max-w-5xl mx-auto">
        <p class="text-forest text-xs md:text-sm font-semibold tracking-widest uppercase text-center mb-2">
          Momentos reales
        </p>
        <h2 class="text-xl md:text-4xl font-semibold text-center text-choco mb-8 md:mb-12">
          Fotos de esta sesión
        </h2>

        <SesionCarrusel images={fotosSesion} alt={titulo} bgColor="#F9F8F6" />
      </div>
    </section>
  )}

  <!-- PACKS -->
  <section class="w-full py-10 md:py-24 px-6" style="background-color: #EFE9E3;">
    <div class="max-w-6xl mx-auto">

      <p class="text-forest text-xs md:text-sm font-semibold tracking-widest uppercase text-center mb-2">
        Elegí tu experiencia
      </p>
      <h2 class="text-xl md:text-4xl font-semibold text-center text-choco mb-8 md:mb-16">
        Packs disponibles
      </h2>

      <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-8 items-center justify-items-center">
        {packs.map((pack, i) => {
          const paleta = paletaPacks[i % paletaPacks.length];
          return (
          <div
            class={`group relative rounded-2xl md:rounded-[2rem] flex flex-col w-full transition-all duration-300 hover:scale-105 hover:-translate-y-1 ${
              i === 1
                ? 'p-5 md:p-10 pt-9 md:pt-14 border-4 shadow-2xl md:scale-110 z-10'
                : 'p-4 md:p-8 border-2 shadow-md'
            }`}
            style={`background-color: ${paleta.bg}; color: ${paleta.texto}; border-color: ${paleta.check};`}
          >

            {i === 1 && (
              <span class="absolute -top-3 md:-top-4 left-1/2 -translate-x-1/2 bg-white text-[10px] md:text-[11px] font-bold uppercase tracking-widest px-4 py-1.5 md:px-5 md:py-2 rounded-full shadow-lg border-2 whitespace-nowrap" style={`color: ${paleta.bg}; border-color: ${paleta.check};`}>
                 Más elegido
              </span>
            )}

            <p class={`font-bold uppercase tracking-widest mb-1 text-center ${i === 1 ? 'text-xl md:text-2xl' : 'text-base md:text-lg'}`}>
              {pack.nombre}
            </p>
            <p class={`text-xs md:text-sm mb-3 md:mb-5 text-center opacity-80`}>
              {pack.tagline}
            </p>

            <ul class="flex-1 space-y-1.5 md:space-y-2.5 mb-4 md:mb-6">
              {pack.items.map((item) => (
                <li class="text-xs md:text-sm flex items-start gap-2 opacity-90">
                  <span class="mt-0.5 font-bold" style={`color: ${paleta.check};`}>✓</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>

            <div class="text-center mb-2 md:mb-3">
              <p class={`font-bold ${i === 1 ? 'text-2xl md:text-4xl' : 'text-xl md:text-3xl'}`}>
                {pack.precio}
              </p>
            </div>

            {pack.precioCuotas && (
              <div class="text-center rounded-xl py-1.5 md:py-2 px-3 mb-3 md:mb-5 text-[10px] md:text-xs font-medium opacity-80" style={`background-color: ${paleta.check}40;`}>
                {pack.precioCuotas}
              </div>
            )}

            <a
              href={pack.linkReserva}
              target="_blank"
              class="text-center text-sm md:text-base rounded-full py-2.5 md:py-3.5 font-bold transition-all duration-300 group-hover:scale-105 shadow-lg hover:opacity-90"
              style={`background-color: ${paleta.boton}; color: ${paleta.botonTexto};`}
            >
              Reservá tu lugar
            </a>

          </div>
        )})}
      </div>

    </div>
  </section>

  <!-- FAQ -->
  <section class="w-full py-16 md:py-24 px-6" style="background-color: #F9F8F6;">
    <div class="max-w-3xl mx-auto">

      <p class="text-forest text-xs md:text-sm font-semibold tracking-widest uppercase text-center mb-2">
        Dudas frecuentes
      </p>
      <h2 class="text-2xl md:text-4xl font-semibold text-center text-choco mb-12 md:mb-16">
        Preguntas frecuentes
      </h2>

      <div class="flex flex-col gap-3">
        {faqs.map((faq) => (
          <details class="group rounded-2xl px-6 py-4 shadow-sm" style="background-color: #EFE9E3;">
            <summary class="flex items-center justify-between cursor-pointer text-choco font-semibold text-sm md:text-base list-none">
              {faq.pregunta}
              <span class="text-choco/40 text-xl group-open:rotate-45 transition-transform duration-300">+</span>
            </summary>
            <p class="text-choco/70 text-sm mt-3 leading-relaxed">
              {faq.respuesta}
            </p>
          </details>
        ))}
      </div>

    </div>
  </section>

  <!-- CTA FINAL -->
  <CTAFinal />

</Layout>
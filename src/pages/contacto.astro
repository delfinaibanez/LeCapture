---
import Layout from '../layouts/Layout.astro';

const whatsapp = '549XXXXXXXXXX'; // reemplazar por el real
const email = 'contacto@lecapture.com'; // reemplazar por el real
const zona = 'Mendoza, Argentina'; // reemplazar por la zona real
---

<Layout title="Contacto">

  <!-- INTRO -->
  <section class="relative w-full py-14 md:py-16 px-6 text-center overflow-hidden" style="background-color: #D9CFC7;">

    <div class="relative z-10">
      <h1 class="font-heading text-3xl md:text-4xl font-bold text-choco mb-3 uppercase tracking-wide">
        Contacto
      </h1>
      <p class="text-choco/70 max-w-lg mx-auto">
        Contame sobre la sesión que estás buscando y coordinamos todo juntas 
      </p>
    </div>
  </section>

  <!-- CARTEL / NOTA (con washi tape) -->
  <div class="relative z-20 max-w-2xl mx-auto px-6 -mt-2 md:-mt-8 mb-16 md:mb-16">
    <div class="relative rotate-[-1.5deg]">

      <!-- Washi tape -->
      <div
        class="absolute -top-3 md:-top-4 left-1/2 -translate-x-1/2 w-24 md:w-28 h-6 md:h-7 rotate-[-2deg] z-10 shadow-sm"
        style="background-color: #C9B59C; border: 1px solid rgba(107,74,63,0.1);"
      ></div>

      <div class="relative bg-white rounded-2xl shadow-lg px-5 py-6 md:px-10 md:py-9 border border-choco/5">
        <p class="font-script text-2xl md:text-3xl text-choco text-center mb-2 md:mb-3">
          Antes de escribirme...
        </p>
        <p class="text-choco/75 text-xs md:text-sm leading-relaxed text-center">
          El estudio funciona solo con cita previa, para asegurarte un espacio
          tranquilo y dedicado. No hace falta que me preguntes por las tarifas:
          en cada sección de la web vas a encontrar el precio y todos los
          detalles de cada sesión. Tené en cuenta que las tarifas y
          características pueden modificarse sin previo aviso, así que si ya lo
          tenés decidido, ¡te recomiendo reservar hoy y asegurarte los precios
          actuales!
        </p>
      </div>

    </div>
  </div>

  <!-- TARJETAS + MAPA -->
  <section class="w-full pt-4 pb-16 md:pb-20 px-6" style="background-color: #F9F8F6;">
    <div class="max-w-4xl mx-auto flex flex-col md:flex-row items-center gap-8 md:gap-6">

      <!-- Columna izquierda: 3 tarjetas -->
      <div class="w-full md:w-2/5 flex flex-col gap-4">

        <!-- WhatsApp -->
        <a
          href={`https://wa.me/${whatsapp}?text=Hola!%20Quiero%20consultar%20por%20una%20sesión`}
          target="_blank"
          class="group rounded-2xl p-4 flex items-center gap-4 border border-choco/10 shadow-[0_2px_10px_rgba(107,74,63,0.08)] hover:shadow-[0_4px_16px_rgba(107,74,63,0.15)] hover:-translate-y-0.5 transition-all duration-300"
          style="background-color: #EFE9E3;"
        >
          <div class="w-14 h-14 md:w-12 md:h-12 shrink-0 rounded-xl flex items-center justify-center shadow-inner" style="background-color: #C9B59C;">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-7 h-7 md:w-6 md:h-6 shrink-0" style="color: #F9F8F6;"><path d="M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z"/></svg>
          </div>
          <div class="text-left">
            <p class="text-choco/40 text-[10px] font-bold uppercase tracking-widest mb-0.5">
              WhatsApp
            </p>
            <p class="text-choco font-bold text-[15px] group-hover:text-forest transition-colors">
              Respuesta más rápida
            </p>
          </div>
        </a>

        <!-- Email -->
        <a
          href={`mailto:${email}`}
          class="group rounded-2xl p-4 flex items-center gap-4 border border-choco/10 shadow-[0_2px_10px_rgba(107,74,63,0.08)] hover:shadow-[0_4px_16px_rgba(107,74,63,0.15)] hover:-translate-y-0.5 transition-all duration-300"
          style="background-color: #EFE9E3;"
        >
          <div class="w-14 h-14 md:w-12 md:h-12 shrink-0 rounded-xl flex items-center justify-center shadow-inner" style="background-color: #C9B59C;">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-7 h-7 md:w-6 md:h-6 shrink-0" style="color: #F9F8F6;"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"/><rect x="2" y="4" width="20" height="16" rx="2"/></svg>
          </div>
          <div class="text-left min-w-0">
            <p class="text-choco/40 text-[10px] font-bold uppercase tracking-widest mb-0.5">
              Email
            </p>
            <p class="text-choco font-bold text-[15px] truncate group-hover:text-forest transition-colors">
              {email}
            </p>
          </div>
        </a>

        <!-- Ubicación -->
        <div class="rounded-2xl p-4 flex items-center gap-4 border border-choco/10 shadow-[0_2px_10px_rgba(107,74,63,0.08)]" style="background-color: #EFE9E3;">
          <div class="w-14 h-14 md:w-12 md:h-12 shrink-0 rounded-xl flex items-center justify-center shadow-inner" style="background-color: #C9B59C;">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-7 h-7 md:w-6 md:h-6 shrink-0" style="color: #F9F8F6;"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div class="text-left">
            <p class="text-choco/40 text-[10px] font-bold uppercase tracking-widest mb-0.5">
              Zona
            </p>
            <p class="text-choco font-bold text-[15px]">{zona}</p>
          </div>
        </div>

      </div>

      <!-- Columna derecha: mapa -->
      <div class="w-full md:w-3/5">
        <div class="rounded-[1.5rem] overflow-hidden shadow-[0_0_0_6px_#F9F8F6]">
          <iframe
            src={`https://www.google.com/maps?q=${encodeURIComponent(zona)}&z=12&output=embed`}
            width="100%"
            height="340"
            style="border:0; display: block;"
            allowfullscreen={false}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>

    </div>
  </section>

</Layout>
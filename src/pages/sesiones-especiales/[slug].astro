---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import CTAFinal from '../../components/CTAFinal.astro';

export async function getStaticPaths() {
  const sesiones = await getCollection('sesionesEspeciales');
  return sesiones.map((sesion) => ({
    params: { slug: sesion.data.slug },
    props: { sesion },
  }));
}

const { sesion } = Astro.props;
const { titulo, subtitulo, descripcion, imagen, mostrarPacks, mostrarFaqs, galeria, videoEmbed, packs, faqs } = sesion.data;
---

<Layout title={titulo}>

  <!-- HERO -->
  <section class="relative w-full h-[55vh] md:h-[65vh] overflow-hidden">
    <Image
      src={imagen}
      alt={titulo}
      width={1600}
      height={1000}
      format="webp"
      quality={85}
      loading="eager"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-[#3D3A36]/80 via-[#3D3A36]/20 to-transparent"></div>
    <div class="absolute inset-0 flex flex-col items-center justify-end text-center px-6 pb-12 md:pb-16">
      <span class="inline-block text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full mb-4 shadow-sm" style="background-color: #A99A8A; color: #F9F8F6;">
        {subtitulo}
      </span>
      <h1 class="font-script text-4xl md:text-6xl font-normal text-[#F9F8F6] mb-4 drop-shadow-md">
        {titulo}
      </h1>
      <p class="text-[#F9F8F6]/90 text-sm md:text-base max-w-xl leading-relaxed drop-shadow-md">
        {descripcion}
      </p>
    </div>
  </section>

  <!-- GALERÍA -->
  {galeria && galeria.length > 0 && (
    <section class="w-full py-16 md:py-20 px-6" style="background-color: #EFE9E3;">
      <p class="text-xs md:text-sm font-semibold tracking-widest uppercase text-center mb-2" style="color: #7A756D;">
        La escenografía
      </p>
      <h2 class="font-heading text-2xl md:text-4xl font-semibold text-center mb-10 md:mb-14" style="color: #3D3A36;">
        Un rincón mágico
      </h2>

      <div class="relative max-w-5xl mx-auto">
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4 md:gap-6">
          {galeria.map((foto, i) => (
            <button
              type="button"
              class="lightbox-trigger group rounded-2xl overflow-hidden shadow-md aspect-square cursor-zoom-in"
              data-index={i}
            >
              <Image
                src={foto}
                alt={`Escenografía ${i + 1}`}
                width={500}
                height={500}
                format="webp"
                quality={98}
                loading="lazy"
                class="lightbox-img w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
              />
            </button>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- LIGHTBOX (modal de foto ampliada) -->
  {galeria && galeria.length > 0 && (
    <div
      id="lightbox-overlay"
      class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/85 p-4 md:p-10"
    >
      <button
        id="lightbox-close"
        aria-label="Cerrar"
        class="absolute top-4 right-4 md:top-6 md:right-6 w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-white text-2xl flex items-center justify-center transition-colors"
      >
        ✕
      </button>
      <button
        id="lightbox-prev"
        aria-label="Anterior"
        class="absolute left-2 md:left-6 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-white/10 hover:bg-white/20 text-white text-2xl flex items-center justify-center transition-colors"
      >
        ‹
      </button>
      <img
        id="lightbox-image"
        src=""
        alt="Foto ampliada"
        class="max-w-full max-h-full rounded-xl shadow-2xl object-contain"
      />
      <button
        id="lightbox-next"
        aria-label="Siguiente"
        class="absolute right-2 md:right-6 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-white/10 hover:bg-white/20 text-white text-2xl flex items-center justify-center transition-colors"
      >
        ›
      </button>
    </div>
  )}

  <script>
    const overlay = document.getElementById('lightbox-overlay');
    const overlayImg = document.getElementById('lightbox-image') as HTMLImageElement | null;
    const closeBtn = document.getElementById('lightbox-close');
    const prevBtn = document.getElementById('lightbox-prev');
    const nextBtn = document.getElementById('lightbox-next');

    const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('.lightbox-trigger'));
    let currentIndex = 0;

    function getSrc(index: number): string | null {
      const img = triggers[index]?.querySelector('img');
      return img ? img.currentSrc || img.src : null;
    }

    function open(index: number) {
      if (!overlay || !overlayImg) return;
      currentIndex = index;
      const src = getSrc(currentIndex);
      if (!src) return;
      overlayImg.src = src;
      overlay.classList.remove('hidden');
      overlay.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }

    function close() {
      if (!overlay) return;
      overlay.classList.add('hidden');
      overlay.classList.remove('flex');
      document.body.style.overflow = '';
    }

    function showRelative(delta: number) {
      if (triggers.length === 0) return;
      currentIndex = (currentIndex + delta + triggers.length) % triggers.length;
      const src = getSrc(currentIndex);
      if (src && overlayImg) overlayImg.src = src;
    }

    triggers.forEach((trigger, i) => {
      trigger.addEventListener('click', () => open(i));
    });

    closeBtn?.addEventListener('click', close);
    prevBtn?.addEventListener('click', () => showRelative(-1));
    nextBtn?.addEventListener('click', () => showRelative(1));

    overlay?.addEventListener('click', (e) => {
      if (e.target === overlay) close();
    });

    document.addEventListener('keydown', (e) => {
      if (overlay?.classList.contains('hidden')) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') showRelative(-1);
      if (e.key === 'ArrowRight') showRelative(1);
    });
  </script>

  <!-- VIDEO -->
  {videoEmbed && (
    <section class="relative w-full py-16 md:py-24 px-6" style="background-color: #F9F8F6;">
      <p class="text-xs md:text-sm font-semibold tracking-widest uppercase text-center mb-2" style="color: #7A756D;">
        Mirá cómo es
      </p>
      <h2 class="font-heading text-2xl md:text-4xl font-semibold text-center mb-10 md:mb-14" style="color: #3D3A36;">
        Detrás de escena
      </h2>

      <div class="max-w-3xl mx-auto relative">
        <div
          class="absolute inset-0 rounded-[1.75rem] rotate-[-2deg] translate-x-3 translate-y-3 md:translate-x-4 md:translate-y-4 -z-10"
          style="background-color: #A99A8A;"
          aria-hidden="true"
        ></div>
        <div class="rounded-[1.75rem] overflow-hidden shadow-2xl" style="border: 4px solid rgba(169,154,138,0.4);" set:html={videoEmbed} />
      </div>
    </section>
  )}

  <!-- PACKS -->
  {mostrarPacks && packs && packs.length > 0 && (
    <section class="w-full py-16 md:py-24 px-6" style="background-color: #EFE9E3;">
      <div class="max-w-6xl mx-auto">
        <p class="text-xs md:text-sm font-semibold tracking-widest uppercase text-center mb-2" style="color: #7A756D;">
          Elegí tu experiencia
        </p>
        <h2 class="font-heading text-2xl md:text-4xl font-semibold text-center mb-12 md:mb-16" style="color: #3D3A36;">
          Packs disponibles
        </h2>

        <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 items-center justify-items-center">
          {packs.map((pack, i) => (
            <div class={`group relative rounded-[2rem] flex flex-col w-full text-center transition-all duration-300 hover:scale-105 hover:-translate-y-1 ${
              i === 1
                ? 'p-8 md:p-10 pt-12 md:pt-14 shadow-2xl md:scale-110 z-10'
                : 'p-7 md:p-8 shadow-md border-2'
            }`}
            style={
              i === 1
                ? 'background-color: #F9F8F6; color: #3D3A36; border: 4px solid #3D3A36;'
                : 'background-color: #F9F8F6; color: #3D3A36; border-color: rgba(122,117,109,0.25);'
            }
            >

              {i === 1 && (
                <span class="absolute -top-4 left-1/2 -translate-x-1/2 text-[11px] font-bold uppercase tracking-widest px-5 py-2 rounded-full shadow-lg border-2 whitespace-nowrap" style="background-color: #3D3A36; color: #F9F8F6; border-color: #3D3A36;">
                  Más elegido
                </span>
              )}

              <p class="font-bold uppercase tracking-widest mb-1 text-lg" style="color: #7A756D;">
                {pack.nombre}
              </p>
              <p class="text-sm mb-5" style="color: rgba(61,58,54,0.7);">
                {pack.tagline}
              </p>

              <ul class="flex-1 flex flex-col items-center space-y-2.5 mb-6">
                {pack.items.map((item) => (
                  <li class="text-sm flex items-start gap-2 max-w-[85%]" style="color: rgba(61,58,54,0.85);">
                    <span class="mt-0.5 font-bold shrink-0" style="color: #7A756D;">✓</span>
                    <span class="text-left">{item}</span>
                  </li>
                ))}
              </ul>

              <div class="text-center mb-3">
                <p class={`font-bold ${i === 1 ? 'text-4xl' : 'text-3xl'}`} style="color: #3D3A36;">
                  {pack.precio}
                </p>
              </div>

              {pack.precioCuotas && (
                <div class="text-center rounded-xl py-2 px-3 mb-5 text-xs font-medium" style="background-color: rgba(169,154,138,0.15); color: rgba(61,58,54,0.85);">
                  {pack.precioCuotas}
                </div>
              )}

              <a
                href={pack.linkReserva}
                target="_blank"
                class="text-center rounded-full py-3.5 font-bold transition-all duration-300 group-hover:scale-105 shadow-lg hover:opacity-90"
                style={
                  i === 1
                    ? 'background-color: #3D3A36; color: #F9F8F6;'
                    : 'background-color: #A99A8A; color: #F9F8F6;'
                }
              >
                Reservá tu lugar
              </a>

            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  {mostrarFaqs && faqs && faqs.length > 0 && (
    <section class="w-full py-16 md:py-24 px-6" style="background-color: #F9F8F6;">
      <div class="max-w-3xl mx-auto">
        <p class="text-xs md:text-sm font-semibold tracking-widest uppercase text-center mb-2" style="color: #7A756D;">
          Dudas frecuentes
        </p>
        <h2 class="font-heading text-2xl md:text-4xl font-semibold text-center mb-12 md:mb-16" style="color: #3D3A36;">
          Preguntas frecuentes
        </h2>

        <div class="flex flex-col gap-3">
          {faqs.map((faq) => (
            <details class="group rounded-2xl px-6 py-4 shadow-sm" style="background-color: #EFE9E3;">
              <summary class="flex items-center justify-between cursor-pointer font-semibold text-sm md:text-base list-none" style="color: #3D3A36;">
                {faq.pregunta}
                <span class="text-xl group-open:rotate-45 transition-transform duration-300" style="color: #7A756D;">+</span>
              </summary>
              <p class="text-sm mt-3 leading-relaxed" style="color: #3D3A36; opacity: 0.8;">
                {faq.respuesta}
              </p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <CTAFinal />

</Layout>
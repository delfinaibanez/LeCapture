---
interface Props {
  bgColor?: string;
  textureColor?: string;
  badgeBg?: string;
  badgeText?: string;
  headingColor?: string;
  textColor?: string;
  buttonBg?: string;
  buttonText?: string;
  badgeLabel?: string;
  heading?: string;
  subtext?: string;
  whatsappNumber?: string;
  whatsappMessage?: string;
}

const {
  bgColor = '#DCCCAC',
  textureColor = '#FFF8EC',
  badgeBg = '#FFF8EC',
  badgeText = '#42362B', // Texto oscuro legible sobre el badge claro
  headingColor = '#2D231A',
  textColor = '#4A3E31',
  buttonBg = '#687850', // Verde oliva profundo sobrio
  buttonText = '#ffffff',
  badgeLabel = 'Reservá tu sesión',
  heading = '¿Lista para capturar esta etapa?',
  subtext = 'Contame qué tenés en mente para tu sesión y coordinamos todos los detalles',
  whatsappNumber = '549XXXXXXXXXX',
  whatsappMessage = 'Hola! Quiero consultar por una sesión',
} = Astro.props;

// SVG en Data URL para la trama
const svgPattern = `data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path d="M0 0h24v24H0z" fill="none"/><path d="M0 3h24M0 9h24M0 15h24M0 21h24M3 0v24M9 0v24M15 0v24M21 0v24" stroke="${encodeURIComponent(textureColor)}" stroke-width="0.8" stroke-dasharray="2 2" opacity="0.45"/></svg>`;
---

<section 
  class="relative w-full py-20 md:py-28 px-6 overflow-hidden" 
  style={`background-color: ${bgColor};`}
>
  <!-- Textura de fondo -->
  <div 
    class="absolute inset-0 pointer-events-none"
    style={`background-image: url('${svgPattern}'); background-size: 24px 24px;`}
  ></div>

  <!-- Viñeta radial suave -->
  <div 
    class="absolute inset-0 pointer-events-none"
    style={`background: radial-gradient(circle at center, transparent 35%, ${bgColor} 92%);`}
  ></div>

  <!-- Contenido central -->
  <div class="relative max-w-2xl mx-auto text-center z-10">

    <span
      class="inline-block text-xs font-semibold tracking-wider uppercase px-4 py-1.5 rounded-full mb-5 shadow-sm"
      style={`background-color: ${badgeBg}; color: ${badgeText};`}
    >
      {badgeLabel}
    </span>

    <h2
      class="font-heading text-2xl md:text-4xl font-semibold mb-4 leading-tight"
      style={`color: ${headingColor};`}
    >
      {heading}
    </h2>

    <p
      class="text-base md:text-lg mb-8 max-w-sm mx-auto"
      style={`color: ${textColor};`}
    >
      {subtext}
    </p>

    <a
      href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`}
      target="_blank"
      class="inline-flex items-center gap-2 px-8 py-3.5 rounded-full font-semibold shadow-md hover:shadow-lg hover:scale-105 transition-all duration-300"
      style={`background-color: ${buttonBg}; color: ${buttonText};`}
    >
      Escribime por WhatsApp
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 shrink-0"><path d="M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719"/></svg>
    </a>

  </div>
</section>
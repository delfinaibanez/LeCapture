---
interface Props {
  badgeLabel?: string;
  heading?: string;
  subtext?: string;
  whatsappNumber?: string;
  whatsappMessage?: string;
}

const {
  badgeLabel = 'Reservá tu sesión',
  heading = '¿Lista para capturar esta etapa?',
  subtext = 'Contame qué tenés en mente para tu sesión y coordinamos todos los detalles',
  whatsappNumber = '549XXXXXXXXXX',
  whatsappMessage = 'Hola! Quiero consultar por una sesión',
} = Astro.props;
---

<section class="relative w-full py-20 md:py-28 px-6 overflow-hidden bg-sand/40">

  <!-- Manchas de color difuminadas de fondo -->
  <div
    class="absolute -top-10 -left-10 w-64 h-64 rounded-full blur-3xl opacity-50 pointer-events-none"
    style="background-color: #fbe8ce;"
    aria-hidden="true"
  ></div>
  <div
    class="absolute -bottom-16 -right-10 w-72 h-72 rounded-full blur-3xl opacity-50 pointer-events-none"
    style="background-color: #c3cc9b;"
    aria-hidden="true"
  ></div>

  <!-- Estrellita decorativa suelta -->
  <span class="hidden md:block absolute top-10 right-[18%] rotate-[-12deg] z-10" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-7 h-7 text-choco/30"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"/></svg>
  </span>

  <!-- Tarjeta flotante con marco grueso (mismo lenguaje que "Sesión especial") -->
  <div class="relative max-w-xl mx-auto z-10">
    <div class="relative bg-cream rounded-[2.5rem] shadow-[0_0_0_6px_#fff8ec,0_0_0_9px_rgba(220,204,172,0.7)] px-8 py-14 md:px-14 md:py-16 text-center">

      <!-- Sticker Corazón -->
      <div
        class="absolute -top-6 -right-3 md:-top-7 md:-right-5 z-20 p-3 rounded-2xl rotate-12 bg-cream border border-choco/10 shadow-md"
        aria-hidden="true"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="var(--color-choco)"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="w-7 h-7"
        >
          <path d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5"/>
        </svg>
      </div>

      <!-- Badge -->
      <span class="inline-block text-xs font-semibold tracking-wider uppercase px-4 py-1.5 rounded-full mb-5 bg-sand/60 text-choco">
        {badgeLabel}
      </span>

      <!-- Título -->
      <h2 class="font-heading text-2xl md:text-4xl font-semibold mb-4 leading-tight text-choco">
        {heading}
      </h2>

      <!-- Subtexto -->
      <p class="text-base md:text-lg mb-8 max-w-sm mx-auto text-choco/80">
        {subtext}
      </p>

      <!-- Botón -->
      <a
        href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`}
        target="_blank"
        style="color: white;"
        class="inline-flex items-center gap-2 px-8 py-3.5 rounded-full font-semibold transition-transform duration-300 bg-sage-button hover:opacity-90 hover:scale-105 shadow-sm"
      >
        Escribime por WhatsApp
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 shrink-0"><path d="M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719"/></svg>
      </a>

    </div>
  </div>
</section>
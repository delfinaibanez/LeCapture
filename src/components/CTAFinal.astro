---
import { Image } from 'astro:assets';
import fotoCta from '../assets/images/home/cta/foto-cta.jpg';

interface Props {
  badgeLabel?: string;
  heading?: string;
  subtext?: string;
  whatsappNumber?: string;
  whatsappMessage?: string;
}

const {
  badgeLabel = 'Reservá tu sesión',
  heading = '¿Lista para capturar esta etapa?',
  subtext = 'Contame qué tenés en mente para tu sesión y coordinamos todos los detalles',
  whatsappNumber = '549XXXXXXXXXX',
  whatsappMessage = 'Hola! Quiero consultar por una sesión',
} = Astro.props;

// Patrón de corazoncitos bien marcados, repetido en mosaico
const heartPattern = `data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 120 120"><g fill="none" stroke="%236b4a3f" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.18"><path transform="translate(10,10) scale(0.7)" d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5"/><path transform="translate(75,55) scale(0.55) rotate(15)" d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5"/><path transform="translate(30,80) scale(0.6) rotate(-12)" d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5"/></g></svg>`;
---

<section class="relative w-full py-20 md:py-32 px-6 overflow-hidden bg-sand/40">

  <!-- Patrón de corazoncitos, más chico en mobile, más grande en desktop -->
  <div
    class="absolute inset-0 pointer-events-none bg-[length:70px_70px] md:bg-[length:120px_120px]"
    style={`background-image: url('${heartPattern}');`}
    aria-hidden="true"
  ></div>

  <div class="relative max-w-3xl mx-auto z-10 flex flex-col md:flex-row items-center justify-center gap-10 md:gap-16 text-center md:text-left">

    <!-- Foto: rectangular, inclinada -->
    <div class="relative shrink-0">
      <div class="relative w-36 h-44 md:w-52 md:h-64 rounded-[1.5rem] overflow-hidden shadow-lg rotate-[-3deg] ring-4 ring-cream">
        <Image
          src={fotoCta}
          alt="Sesión de fotos LeCapture"
          width={500}
          height={625}
          format="webp"
          quality={85}
          loading="lazy"
          class="w-full h-full object-cover"
        />
      </div>

      <!-- Sticker Corazón principal -->
      <div
        class="absolute -top-3 -right-4 z-20 p-2 rounded-xl rotate-12 bg-cream border border-choco/10 shadow-md"
        aria-hidden="true"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="var(--color-choco)"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="w-5 h-5"
        >
          <path d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5"/>
        </svg>
      </div>
    </div>

    <!-- Texto -->
    <div class="flex flex-col items-center md:items-start">
      <span class="inline-block text-xs font-semibold tracking-wider uppercase px-4 py-1.5 rounded-full mb-5 bg-cream text-choco shadow-sm">
        {badgeLabel}
      </span>

      <h2 class="font-heading text-2xl md:text-4xl font-semibold mb-4 leading-tight text-choco">
        {heading}
      </h2>

      <p class="text-sm md:text-base mb-8 max-w-sm text-choco/80">
        {subtext}
      </p>

      <a
        href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`}
        target="_blank"
        style="color: white;"
        class="inline-flex items-center gap-2 px-8 py-3.5 rounded-full font-semibold transition-transform duration-300 bg-sage-button hover:opacity-90 hover:scale-105 shadow-sm"
      >
        Escribime por WhatsApp
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0"><path d="M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719"/></svg>
      </a>
    </div>

  </div>
</section>
---
interface Props {
  bgColor?: string;
  gridLight?: string;
  gridDark?: string;
  badgeBg?: string;
  badgeText?: string;
  headingColor?: string;
  textColor?: string;
  buttonBg?: string;
  buttonText?: string;
  badgeLabel?: string;
  heading?: string;
  subtext?: string;
  whatsappNumber?: string;
  whatsappMessage?: string;
}

const {
  bgColor = '#E4DFB5',
  gridLight = 'rgba(251,232,206,0.7)',
  gridDark = 'rgba(195,204,155,0.5)',
  badgeBg = '#546b41',
  badgeText = '#ffffff',
  headingColor = '#6b4a3f',
  textColor = '#6b4a3f',
  buttonBg = '#546b41',
  buttonText = '#ffffff',
  badgeLabel = 'Reservá tu sesión',
  heading = '¿Lista para capturar esta etapa?',
  subtext = 'Contame qué tenés en mente para tu sesión y coordinamos todos los detalles',
  whatsappNumber = '549XXXXXXXXXX',
  whatsappMessage = 'Hola! Quiero consultar por una sesión',
} = Astro.props;
---

<section
  class="relative w-full py-16 md:py-24 px-6 overflow-hidden"
  style={`
    background-color: ${bgColor};
    background-image:
      repeating-linear-gradient(90deg, transparent, transparent 16px, ${gridLight} 16px, ${gridLight} 28px, transparent 28px, transparent 44px),
      repeating-linear-gradient(0deg, transparent, transparent 16px, ${gridLight} 16px, ${gridLight} 28px, transparent 28px, transparent 44px),
      repeating-linear-gradient(90deg, transparent, transparent 16px, ${gridDark} 16px, ${gridDark} 28px, transparent 28px, transparent 44px),
      repeating-linear-gradient(0deg, transparent, transparent 16px, ${gridDark} 16px, ${gridDark} 28px, transparent 28px, transparent 44px);
  `}
>
  <div class="relative max-w-2xl mx-auto text-center">

    <span
      class="inline-block text-xs font-semibold tracking-wide uppercase px-4 py-1.5 rounded-full mb-5"
      style={`background-color: ${badgeBg}; color: ${badgeText};`}
    >
      {badgeLabel}
    </span>

    <h2
      class="font-heading text-2xl md:text-4xl font-semibold mb-4 leading-tight"
      style={`color: ${headingColor};`}
    >
      {heading}
    </h2>

    <p
      class="text-base md:text-lg mb-8 max-w-sm mx-auto"
      style={`color: ${textColor};`}
    >
      {subtext}
    </p>

    <a
      href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`}
      target="_blank"
      class="inline-flex items-center gap-2 px-8 py-3.5 rounded-full font-semibold shadow-md hover:scale-105 transition-transform duration-300"
      style={`background-color: ${buttonBg}; color: ${buttonText};`}
    >
      Escribime por WhatsApp
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 shrink-0"><path d="M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719"/></svg>
    </a>

  </div>
</section>
---
import { Image } from 'astro:assets';
import fotoCta from '../assets/images/home/cta/foto-cta.jpg';

interface Props {
  badgeLabel?: string;
  heading?: string;
  subtext?: string;
  whatsappNumber?: string;
  whatsappMessage?: string;
}

const {
  badgeLabel = 'Reservá tu sesión',
  heading = '¿Lista para capturar esta etapa?',
  subtext = 'Contame qué tenés en mente para tu sesión y coordinamos todos los detalles',
  whatsappNumber = '549XXXXXXXXXX',
  whatsappMessage = 'Hola! Quiero consultar por una sesión',
} = Astro.props;
---

<section class="relative w-full py-20 md:py-32 px-6 overflow-hidden" style="background-color: #EFE9E3;">

  <div class="relative max-w-3xl mx-auto z-10 flex flex-col md:flex-row items-center justify-center gap-10 md:gap-16 text-center md:text-left">

    <!-- Foto: rectangular, inclinada -->
    <div class="relative shrink-0">
      <div class="relative w-36 h-44 md:w-52 md:h-64 rounded-[1.5rem] overflow-hidden shadow-lg rotate-[-3deg] ring-4 ring-[#F9F8F6]">
        <Image
          src={fotoCta}
          alt="Sesión de fotos LeCapture"
          width={500}
          height={625}
          format="webp"
          quality={85}
          loading="lazy"
          class="w-full h-full object-cover"
        />
      </div>

    </div>

    <!-- Texto -->
    <div class="flex flex-col items-center md:items-start">
      <span class="inline-block text-xs font-semibold tracking-wider uppercase px-4 py-1.5 rounded-full mb-5 text-[#7A756D] shadow-sm" style="background-color: #F9F8F6;">
        {badgeLabel}
      </span>

      <h2 class="font-heading text-2xl md:text-4xl font-semibold mb-4 leading-tight text-[#3D3A36]">
        {heading}
      </h2>

      <p class="text-sm md:text-base mb-8 max-w-sm text-[#3D3A36]/80">
        {subtext}
      </p>

      <a
        href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`}
        target="_blank"
        style="color: white; background-color: #7A756D;"
        class="inline-flex items-center gap-2 px-8 py-3.5 rounded-full font-semibold transition-transform duration-300 hover:opacity-90 hover:scale-105 shadow-sm"
      >
        Escribime por WhatsApp
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0"><path d="M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719"/></svg>
      </a>
    </div>

  </div>
</section>
---
interface Props {
  badgeLabel?: string;
  heading?: string;
  subtext?: string;
  whatsappNumber?: string;
  whatsappMessage?: string;
}

const {
  badgeLabel = 'Reservá tu sesión',
  heading = '¿Lista para capturar esta etapa?',
  subtext = 'Contame qué tenés en mente para tu sesión y coordinamos todos los detalles',
  whatsappNumber = '549XXXXXXXXXX',
  whatsappMessage = 'Hola! Quiero consultar por una sesión',
} = Astro.props;

// Trama blanca continua usando SVG
const svgPattern = `data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path d="M0 0h24v24H0z" fill="none"/><path d="M0 3h24M0 9h24M0 15h24M0 21h24M3 0v24M9 0v24M15 0v24M21 0v24" stroke="%23ffffff" stroke-width="0.9" stroke-dasharray="2 2" opacity="0.75"/></svg>`;
---

<section 
  class="relative w-full py-20 md:py-28 px-6 overflow-hidden bg-[#F3EBE0]"
>
  <!-- Textura de entramado claro -->
  <div 
    class="absolute inset-0 pointer-events-none"
    style={`background-image: url('${svgPattern}'); background-size: 24px 24px;`}
  ></div>

  <!-- Contenido central -->
  <div class="relative max-w-2xl mx-auto text-center z-10">

    <!-- Sticker Corazón plano -->
    <div 
      class="absolute -top-6 -right-2 md:right-4 z-20 p-2.5 rounded-2xl rotate-12 border border-white/80 bg-[var(--color-cream)] pointer-events-none shadow-sm"
    >
      <svg 
        xmlns="http://www.w3.org/2000/svg" 
        width="24" 
        height="24" 
        viewBox="0 0 24 24" 
        fill="none" 
        stroke="var(--color-choco)" 
        stroke-width="2" 
        stroke-linecap="round" 
        stroke-linejoin="round" 
        class="lucide lucide-heart w-6 h-6"
      >
        <path d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5"/>
      </svg>
    </div>

    <!-- Badge -->
    <span
      class="inline-block text-xs font-semibold tracking-wider uppercase px-4 py-1.5 rounded-full mb-5 bg-[var(--color-cream)] text-[var(--color-choco)] shadow-sm"
    >
      {badgeLabel}
    </span>

    <!-- Título principal -->
    <h2
      class="font-heading text-2xl md:text-4xl font-semibold mb-4 leading-tight text-[var(--color-choco)]"
    >
      {heading}
    </h2>

    <!-- Bajada/Subtexto -->
    <p
      class="text-base md:text-lg mb-8 max-w-sm mx-auto opacity-90 text-[var(--color-choco)]"
    >
      {subtext}
    </p>

    <!-- Botón -->
    <a
      href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`}
      target="_blank"
      class="inline-flex items-center gap-2 px-8 py-3.5 rounded-full font-semibold transition-all duration-300 bg-[var(--color-forest)] text-[var(--color-cream)] hover:bg-[var(--color-sage-button)]"
    >
      Escribime por WhatsApp
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 shrink-0"><path d="M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719"/></svg>
    </a>

  </div>
</section>
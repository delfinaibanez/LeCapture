---
import { Image } from 'astro:assets';
import sinEditar from '../assets/images/home/edicion/sin-editar.jpg';
import editada from '../assets/images/home/edicion/editada.jpg';
import sinEditar2 from '../assets/images/home/edicion/sin-editar-2.jpg';
import editada2 from '../assets/images/home/edicion/editada-2.jpg';

const comparaciones = [
  { antes: sinEditar, despues: editada },
  { antes: sinEditar2, despues: editada2 },
];
---

<section
  class="w-full py-16 md:py-24 px-6"
  style="background-color: #F9F8F6;"
>
  <p class="text-[#7A756D] text-xs md:text-sm font-semibold tracking-widest uppercase text-center mb-2">
    El detrás de escena
  </p>
  <h2 class="text-2xl md:text-4xl font-semibold text-center text-[#3D3A36] mb-4">
    La magia de la edición
  </h2>
  <p class="text-[#3D3A36]/70 text-center max-w-lg mx-auto mb-10 md:mb-14">
    Deslizá para ver la transformación 
  </p>

  <div class="max-w-lg md:max-w-4xl mx-auto flex flex-col md:flex-row gap-16 md:gap-10">
    {comparaciones.map((foto) => (
      <div class="relative md:flex-1">

        <!-- Tarjeta de color asomando detrás -->
        <div
          class="absolute inset-0 rounded-[2rem] rotate-[4deg] translate-x-4 translate-y-4 md:translate-x-6 md:translate-y-6 -z-10 shadow-lg border-4"
          style="background-color: rgb(217, 207, 199); border-color: #fff8ec;"
          aria-hidden="true"
        ></div>

        <div
          class="comparador relative w-full aspect-[4/3] rounded-[2rem] overflow-hidden shadow-lg select-none cursor-ew-resize"
          style="touch-action: none;"
        >
          <!-- Foto editada: fondo, siempre completa, tamaño fijo -->
          <Image
            src={foto.despues}
            alt="Foto editada"
            width={800}
            height={600}
            format="webp"
            quality={85}
            loading="lazy"
            class="absolute inset-0 w-full h-full object-cover pointer-events-none"
          />

          <!-- Foto sin editar: mismo tamaño exacto, se recorta con clip-path -->
          <div
            class="comparador-original absolute inset-0 w-full h-full pointer-events-none"
            style="clip-path: inset(0 50% 0 0);"
          >
            <Image
              src={foto.antes}
              alt="Foto sin editar"
              width={800}
              height={600}
              format="webp"
              quality={85}
              loading="lazy"
              class="absolute inset-0 w-full h-full object-cover"
            />
          </div>

          <!-- Etiquetas -->
          <span class="absolute top-4 left-4 backdrop-blur-md text-white text-xs font-semibold px-3 py-1 rounded-full pointer-events-none shadow-sm" style="background-color: rgba(201, 181, 156, 0.55);">
            Sin editar
          </span>
          <span class="absolute top-4 right-4 backdrop-blur-md text-white text-xs font-semibold px-3 py-1 rounded-full pointer-events-none shadow-sm" style="background-color: rgba(201, 181, 156, 0.55);">
            Editada
          </span>

          <!-- Línea + manija -->
          <div class="comparador-linea absolute top-0 bottom-0 w-1 bg-white shadow-md pointer-events-none" style="left: 50%;">
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white shadow-lg flex items-center justify-center">
              <span class="text-choco text-sm">↔</span>
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  const comparadores = document.querySelectorAll<HTMLElement>('.comparador');

  comparadores.forEach((comparador) => {
    const original = comparador.querySelector<HTMLElement>('.comparador-original');
    const linea = comparador.querySelector<HTMLElement>('.comparador-linea');

    let dragging = false;

    function mover(clientX: number) {
      if (!original || !linea) return;
      const rect = comparador.getBoundingClientRect();
      let pos = ((clientX - rect.left) / rect.width) * 100;
      pos = Math.max(0, Math.min(100, pos));
      original.style.clipPath = `inset(0 ${100 - pos}% 0 0)`;
      linea.style.left = `${pos}%`;
    }

    // --- Mouse ---
    comparador.addEventListener('mousedown', () => (dragging = true));
    window.addEventListener('mouseup', () => (dragging = false));
    window.addEventListener('mousemove', (e) => {
      if (dragging) mover(e.clientX);
    });

    comparador.addEventListener('click', (e) => {
      mover((e as MouseEvent).clientX);
    });

    // --- Touch ---
    comparador.addEventListener(
      'touchstart',
      (e) => {
        dragging = true;
        if (e.touches[0]) mover(e.touches[0].clientX);
      },
      { passive: false }
    );

    window.addEventListener('touchend', () => (dragging = false));

    window.addEventListener(
      'touchmove',
      (e) => {
        if (dragging && e.touches[0]) {
          e.preventDefault();
          mover(e.touches[0].clientX);
        }
      },
      { passive: false }
    );
  });
</script>
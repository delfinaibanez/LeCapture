---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const todas = await getCollection('sesionesEspeciales');
const activa = todas.find((s: (typeof todas)[number]) => s.data.activa);
---

{activa && (
  <section class="w-full py-16 md:py-24 px-4 md:px-6" style="background-color: #F9F8F6;">
    <div class="max-w-4xl mx-auto relative">

      <div class="rounded-[2.5rem] shadow-xl overflow-hidden" style="background-color: #EFE9E3;">
        <div class="flex flex-col md:flex-row items-center">

          <!-- Foto ovalada con etiqueta colgante -->
          <div class="relative w-full md:w-1/2 p-8 md:p-10 flex justify-center">
            <div class="relative w-64 h-64 md:w-72 md:h-72 rounded-full overflow-hidden shadow-lg rotate-[-3deg] border-8" style="border-color: #F9F8F6;">
              <Image
                src={activa.data.imagen}
                alt={activa.data.titulo}
                width={500}
                height={500}
                format="webp"
                quality={85}
                loading="lazy"
                class="w-full h-full object-cover"
              />
            </div>
            <!-- Etiqueta colgante -->
            <div class="absolute top-4 right-6 md:right-10 rounded-sm px-3 py-1.5 shadow-md rotate-[8deg] text-xs font-semibold flex items-center gap-1.5 text-[#7A756D]" style="background-color: #F9F8F6; border: 1px solid rgba(122,117,109,0.2);">
             
              LeCapture
            </div>
          </div>

          <!-- Texto -->
          <div class="w-full md:w-1/2 p-8 md:pr-12 text-center md:text-left">
            <span class="inline-flex items-center gap-1.5 text-sm font-semibold px-4 py-1.5 rounded-full mb-4 text-[#7A756D] shadow-sm" style="background-color: #FFFFFF;">
              Sesión especial
            </span>
            <h2 class="font-script text-2xl md:text-4xl font-normal text-[#3D3A36] mb-2">
              {activa.data.titulo}
            </h2>
            <p class="text-[#3D3A36]/70 text-base md:text-lg mb-6">
              {activa.data.subtitulo}
            </p>
            <a
              href="/sesiones-especiales/dia-de-la-madre-2026"
              style="background-color: #A99A8A; color: white;"
              class="inline-flex items-center px-7 py-3.5 rounded-full font-semibold shadow-sm hover:opacity-90 hover:scale-105 transition-transform duration-300"
            >
              Reservar ahora
            </a>
          </div>

        </div>
      </div>

    </div>
  </section>
)}
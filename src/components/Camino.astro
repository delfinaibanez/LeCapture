---
import { Image } from 'astro:assets';
import embarazo from '../assets/images/home/camino/01-embarazo.jpg';
import recienNacido from '../assets/images/home/camino/02-recien-nacido.jpg';
import miniBaby from '../assets/images/home/camino/03-mini-baby.jpg';
import primerAnito from '../assets/images/home/camino/04-primer-anito.jpg';
import infantiles from '../assets/images/home/camino/05-infantiles.jpg';

const etapas = [
  { nombre: 'Embarazo', img: embarazo, href: '/sesiones/embarazo' },
  { nombre: 'Recién Nacido', img: recienNacido, href: '/sesiones/recien-nacidos' },
  { nombre: 'Mini Baby', img: miniBaby, href: '/sesiones/mini-baby' },
  { nombre: 'Primer Añito', img: primerAnito, href: '/sesiones/primer-anito' },
  { nombre: 'Infantiles', img: infantiles, href: '/sesiones/infantiles' },
];
---

<section class="w-full py-16 md:py-24 bg-sand/30">
  <div class="px-6">
    <p class="text-forest text-xs md:text-sm font-semibold tracking-widest uppercase text-center mb-2">
      Sesiones
    </p>
    <h2 class="text-2xl md:text-4xl font-semibold text-center text-choco mb-4">
      Un camino, una historia
    </h2>
    <p class="text-choco/70 text-center max-w-lg mx-auto mb-12 md:mb-16">
      Acompañamos cada etapa, desde la panza hasta los primeros pasos.
    </p>
  </div>

  <!-- MOBILE: carrusel horizontal con flechas -->
  <div class="md:hidden relative">
    <div
      id="camino-scroll"
      class="flex gap-5 overflow-x-auto snap-x snap-mandatory py-3 scrollbar-hide px-12"
      style="scroll-padding-inline: 3rem;"
    >
      {etapas.map((etapa, i) => (
        <a
          href={etapa.href}
          class="group flex flex-col items-center text-center snap-center shrink-0 w-24"
        >
          <div class="relative w-24 h-24 rounded-full overflow-hidden ring-4 ring-white shadow-md bg-cream">
            <Image
              src={etapa.img}
              alt={etapa.nombre}
              width={256}
              height={256}
              format="webp"
              quality={80}
              loading="lazy"
              class="w-full h-full object-cover"
            />
            <span class="absolute -top-1 -right-1 bg-gray-900 text-white text-xs w-5 h-5 rounded-full flex items-center justify-center">
              {i + 1}
            </span>
          </div>
          <span class="mt-3 text-sm font-medium text-choco">
            {etapa.nombre}
          </span>
        </a>
      ))}
    </div>

    <!-- Flechas: pegadas al borde real de la pantalla -->
    <button
      id="camino-prev"
      aria-label="Ver anterior"
      class="absolute left-0 top-9 z-10 w-8 h-8 rounded-full bg-white shadow-md flex items-center justify-center text-choco/60 hover:text-choco transition-opacity duration-200"
    >
      <span class="text-lg leading-none -mt-0.5">‹</span>
    </button>
    <button
      id="camino-next"
      aria-label="Ver siguiente"
      class="absolute right-0 top-9 z-10 w-8 h-8 rounded-full bg-white shadow-md flex items-center justify-center text-choco/60 hover:text-choco transition-opacity duration-200"
    >
      <span class="text-lg leading-none -mt-0.5">›</span>
    </button>
  </div>

  <script>
    const scrollEl = document.getElementById('camino-scroll') as HTMLDivElement | null;
    const nextBtn = document.getElementById('camino-next') as HTMLButtonElement | null;
    const prevBtn = document.getElementById('camino-prev') as HTMLButtonElement | null;

    const STEP = 116; // ancho de card (96px) + gap (20px)
    const TOLERANCE = 4; // margen de error por redondeos de scroll

    function updateArrows() {
      if (!scrollEl || !nextBtn || !prevBtn) return;

      const maxScroll = scrollEl.scrollWidth - scrollEl.clientWidth;
      const atStart = scrollEl.scrollLeft <= TOLERANCE;
      const atEnd = scrollEl.scrollLeft >= maxScroll - TOLERANCE;

      prevBtn.disabled = atStart;
      prevBtn.classList.toggle('opacity-0', atStart);
      prevBtn.classList.toggle('pointer-events-none', atStart);

      nextBtn.disabled = atEnd;
      nextBtn.classList.toggle('opacity-0', atEnd);
      nextBtn.classList.toggle('pointer-events-none', atEnd);
    }

    nextBtn?.addEventListener('click', () => {
      if (!scrollEl) return;
      const maxScroll = scrollEl.scrollWidth - scrollEl.clientWidth;
      const target = Math.min(scrollEl.scrollLeft + STEP * 2, maxScroll);
      scrollEl.scrollTo({ left: target, behavior: 'smooth' });
    });

    prevBtn?.addEventListener('click', () => {
      if (!scrollEl) return;
      const target = Math.max(scrollEl.scrollLeft - STEP * 2, 0);
      scrollEl.scrollTo({ left: target, behavior: 'smooth' });
    });

    scrollEl?.addEventListener('scroll', updateArrows);
    // Estado inicial al cargar
    updateArrows();
  </script>

  <!-- DESKTOP: línea horizontal -->
  <div class="hidden md:flex relative items-start justify-between max-w-5xl mx-auto gap-4 px-6">
    <div class="absolute top-16 left-0 h-0.5 w-full bg-gray-200 -z-10"></div>

    {etapas.map((etapa) => (
      <a
        href={etapa.href}
        class="group flex flex-col items-center text-center w-1/5"
      >
        <div class="relative w-32 h-32 rounded-full overflow-hidden ring-4 ring-white shadow-md group-hover:ring-cream group-hover:scale-105 transition-all duration-300 bg-cream">
          <Image
            src={etapa.img}
            alt={etapa.nombre}
            width={256}
            height={256}
            format="webp"
            quality={80}
            loading="lazy"
            class="w-full h-full object-cover"
          />
        </div>
        <span class="mt-4 font-medium text-choco">
          {etapa.nombre}
        </span>
      </a>
    ))}
  </div>
</section>
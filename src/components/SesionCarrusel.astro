---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: ImageMetadata[];
  alt?: string;
  bgColor?: string;
}

const { images, alt = 'Foto de la sesión', bgColor = '#F9F8F6' } = Astro.props;
---

<div class="w-full">
  <!-- MOBILE: carrusel horizontal con scroll nativo -->
  <div class="md:hidden relative -mx-6 px-6">
    <div class="carrusel-scroll-mobile flex gap-4 overflow-x-auto snap-x snap-mandatory pb-4 scrollbar-hide">
      {images.map((foto, i) => (
        <div class="snap-center shrink-0 w-[78vw] max-w-80 aspect-[4/3] rounded-[1.5rem] overflow-hidden shadow-md">
          <Image
            src={foto}
            alt={`${alt} ${i + 1}`}
            width={500}
            height={380}
            format="webp"
            quality={85}
            loading="lazy"
            class="w-full h-full object-cover"
          />
        </div>
      ))}
    </div>

    <div
      class="pointer-events-none absolute top-0 left-0 h-[calc(100%-1rem)] w-10"
      style={`background: linear-gradient(to right, ${bgColor}, transparent);`}
    ></div>
    <div
      class="pointer-events-none absolute top-0 right-0 h-[calc(100%-1rem)] w-10"
      style={`background: linear-gradient(to left, ${bgColor}, transparent);`}
    ></div>
  </div>

  <!-- DESKTOP: carrusel deslizante -->
  <div class="carrusel-desktop hidden md:block relative overflow-hidden">
    <div class="carrusel-track flex gap-4 pb-4 transition-transform duration-700 ease-[cubic-bezier(0.65,0,0.35,1)]">
      {images.map((foto, i) => (
        <div class="shrink-0 w-56 aspect-square rounded-[1.5rem] overflow-hidden shadow-md group">
          <Image
            src={foto}
            alt={`${alt} ${i + 1}`}
            width={400}
            height={400}
            format="webp"
            quality={85}
            loading="lazy"
            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
          />
        </div>
      ))}
    </div>

    <div
      class="pointer-events-none absolute top-0 left-0 h-[calc(100%-1rem)] w-16"
      style={`background: linear-gradient(to right, ${bgColor}, transparent);`}
    ></div>
    <div
      class="pointer-events-none absolute top-0 right-0 h-[calc(100%-1rem)] w-16"
      style={`background: linear-gradient(to left, ${bgColor}, transparent);`}
    ></div>

    <button
      class="carrusel-prev absolute left-0 top-1/2 -translate-y-1/2 text-choco/50 hover:text-choco text-4xl leading-none px-2 transition-colors"
      aria-label="Ver anterior"
    >
      ‹
    </button>
    <button
      class="carrusel-next absolute right-0 top-1/2 -translate-y-1/2 text-choco/50 hover:text-choco text-4xl leading-none px-2 transition-colors"
      aria-label="Ver siguiente"
    >
      ›
    </button>
  </div>
</div>

<script>
  // Soporta uno o varios carruseles en la misma página sin que se pisen entre sí.
  const carruseles = document.querySelectorAll<HTMLElement>('.carrusel-desktop');

  carruseles.forEach((contenedor) => {
    const track = contenedor.querySelector<HTMLElement>('.carrusel-track');
    const nextBtn = contenedor.querySelector<HTMLElement>('.carrusel-next');
    const prevBtn = contenedor.querySelector<HTMLElement>('.carrusel-prev');

    let index = 0;
    const gap = 16; // gap-4

    function getCardWidth() {
      const card = track?.querySelector('div') as HTMLElement | null;
      return card ? card.offsetWidth + gap : 0;
    }

    function maxIndex() {
      if (!track) return 0;
      const cardCount = track.children.length;
      const visible = Math.floor(contenedor.offsetWidth / getCardWidth());
      return Math.max(cardCount - visible, 0);
    }

    function update() {
      if (!track) return;
      const offset = index * getCardWidth();
      track.style.transform = `translateX(-${offset}px)`;
    }

    nextBtn?.addEventListener('click', () => {
      index = Math.min(index + 1, maxIndex());
      update();
    });

    prevBtn?.addEventListener('click', () => {
      index = Math.max(index - 1, 0);
      update();
    });

    window.addEventListener('resize', update);
  });
</script>
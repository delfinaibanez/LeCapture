---
import Layout from '../layouts/Layout.astro';

const whatsapp = '549XXXXXXXXXX'; // reemplazar por el real
const email = 'contacto@lecapture.com'; // reemplazar por el real
const zona = 'Mendoza, Argentina'; // reemplazar por la zona real
---

<Layout title="Contacto">

  <!-- INTRO con cuadrillé -->
  <section
    class="relative w-full py-14 md:py-16 px-6 text-center overflow-hidden"
    style="
      background-color: #E4DFB5;
      background-image:
        repeating-linear-gradient(90deg, transparent, transparent 16px, rgba(251,232,206,0.45) 16px, rgba(251,232,206,0.45) 28px, transparent 28px, transparent 44px),
        repeating-linear-gradient(0deg, transparent, transparent 16px, rgba(251,232,206,0.45) 16px, rgba(251,232,206,0.45) 28px, transparent 28px, transparent 44px),
        repeating-linear-gradient(90deg, transparent, transparent 16px, rgba(195,204,155,0.3) 16px, rgba(195,204,155,0.3) 28px, transparent 28px, transparent 44px),
        repeating-linear-gradient(0deg, transparent, transparent 16px, rgba(195,204,155,0.3) 16px, rgba(195,204,155,0.3) 28px, transparent 28px, transparent 44px);
    "
  >
    <h1 class="font-heading text-3xl md:text-4xl font-bold text-choco mb-3 uppercase tracking-wide">
      Contacto
    </h1>
    <p class="text-choco/70 max-w-lg mx-auto">
      Contame sobre la sesión que estás buscando y coordinamos todo juntas ✨
    </p>
  </section>

  <!-- CARTEL / NOTA (con washi tape y sticker) -->
  <div class="relative z-20 max-w-2xl mx-auto px-6 -mt-2 md:-mt-8 mb-16 md:mb-16">
    <div class="relative rotate-[-1.5deg]">

      <!-- Washi tape -->
      <div
        class="absolute -top-3 md:-top-4 left-1/2 -translate-x-1/2 w-24 md:w-28 h-6 md:h-7 rotate-[-2deg] z-10 shadow-sm"
        style="background-color: rgba(228,223,181,0.85); border: 1px solid rgba(107,74,63,0.1);"
      ></div>

      <!-- Sticker estrella -->
      <div class="absolute -top-5 -right-3 md:-top-6 md:-right-5 z-10 rotate-[12deg]">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="#FBE8CE" stroke="#6b4a3f" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-9 h-9 md:w-11 md:h-11 drop-shadow-sm"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>
      </div>

      <div class="relative bg-white rounded-2xl shadow-lg px-5 py-6 md:px-10 md:py-9 border border-choco/5">
        <p class="font-script text-2xl md:text-3xl text-choco text-center mb-2 md:mb-3">
          Antes de escribirme...
        </p>
        <p class="text-choco/75 text-xs md:text-sm leading-relaxed text-center">
          El estudio funciona solo con cita previa, para asegurarte un espacio
          tranquilo y dedicado. No hace falta que me preguntes por las tarifas:
          en cada sección de la web vas a encontrar el precio y todos los
          detalles de cada sesión. Tené en cuenta que las tarifas y
          características pueden modificarse sin previo aviso, así que si ya lo
          tenés decidido, ¡te recomiendo reservar hoy y asegurarte los precios
          actuales!
        </p>
      </div>

    </div>
  </div>

  <!-- TARJETAS + MAPA -->
  <section class="w-full pt-4 pb-16 md:pb-20 px-6 bg-cream">
    <div class="max-w-4xl mx-auto flex flex-col md:flex-row items-center gap-8 md:gap-6">

      <!-- Columna izquierda: 3 tarjetas -->
      <div class="w-full md:w-2/5 flex flex-col gap-4">

        <!-- WhatsApp -->
        <a
          href={`https://wa.me/${whatsapp}?text=Hola!%20Quiero%20consultar%20por%20una%20sesión`}
          target="_blank"
          class="group bg-white rounded-2xl p-4 flex items-center gap-4 border border-choco/10 shadow-[0_2px_10px_rgba(107,74,63,0.08)] hover:shadow-[0_4px_16px_rgba(107,74,63,0.15)] hover:-translate-y-0.5 transition-all duration-300"
        >
          <div class="w-14 h-14 md:w-12 md:h-12 shrink-0 rounded-xl flex items-center justify-center shadow-inner" style="background-color: #DCCCAC;">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-7 h-7 md:w-6 md:h-6 shrink-0" style="color: #6b4a3f;"><path d="M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z"/></svg>
          </div>
          <div class="text-left">
            <p class="text-choco/40 text-[10px] font-bold uppercase tracking-widest mb-0.5">
              WhatsApp
            </p>
            <p class="text-choco font-bold text-[15px] group-hover:text-forest transition-colors">
              Respuesta más rápida
            </p>
          </div>
        </a>

        <!-- Email -->
        <a
          href={`mailto:${email}`}
          class="group bg-white rounded-2xl p-4 flex items-center gap-4 border border-choco/10 shadow-[0_2px_10px_rgba(107,74,63,0.08)] hover:shadow-[0_4px_16px_rgba(107,74,63,0.15)] hover:-translate-y-0.5 transition-all duration-300"
        >
          <div class="w-14 h-14 md:w-12 md:h-12 shrink-0 rounded-xl flex items-center justify-center shadow-inner" style="background-color: #DCCCAC;">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-7 h-7 md:w-6 md:h-6 shrink-0" style="color: #6b4a3f;"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"/><rect x="2" y="4" width="20" height="16" rx="2"/></svg>
          </div>
          <div class="text-left min-w-0">
            <p class="text-choco/40 text-[10px] font-bold uppercase tracking-widest mb-0.5">
              Email
            </p>
            <p class="text-choco font-bold text-[15px] truncate group-hover:text-forest transition-colors">
              {email}
            </p>
          </div>
        </a>

        <!-- Ubicación -->
        <div class="bg-white rounded-2xl p-4 flex items-center gap-4 border border-choco/10 shadow-[0_2px_10px_rgba(107,74,63,0.08)]">
          <div class="w-14 h-14 md:w-12 md:h-12 shrink-0 rounded-xl flex items-center justify-center shadow-inner" style="background-color: #DCCCAC;">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-7 h-7 md:w-6 md:h-6 shrink-0" style="color: #6b4a3f;"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div class="text-left">
            <p class="text-choco/40 text-[10px] font-bold uppercase tracking-widest mb-0.5">
              Zona
            </p>
            <p class="text-choco font-bold text-[15px]">{zona}</p>
          </div>
        </div>

      </div>

      <!-- Columna derecha: mapa -->
      <div class="w-full md:w-3/5">
        <div class="rounded-[1.5rem] overflow-hidden shadow-[0_0_0_5px_#fff8ec,0_0_0_8px_rgba(220,204,172,0.7)]">
          <iframe
            src={`https://www.google.com/maps?q=${encodeURIComponent(zona)}&z=12&output=embed`}
            width="100%"
            height="340"
            style="border:0; display: block;"
            allowfullscreen={false}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>

    </div>
  </section>

</Layout>
---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import retrato from '../assets/images/sobre-mi/retrato.jpg';
import detrasCamara1 from '../assets/images/sobre-mi/detras-camara/foto1.jpg';
import detrasCamara2 from '../assets/images/sobre-mi/detras-camara/foto2.jpg';
import detrasCamara3 from '../assets/images/sobre-mi/detras-camara/foto3.jpg';

import estudio1 from '../assets/images/sobre-mi/estudio/foto1.jpg';
import estudio2 from '../assets/images/sobre-mi/estudio/foto2.jpg';
import estudio3 from '../assets/images/sobre-mi/estudio/foto3.jpg';
import estudio4 from '../assets/images/sobre-mi/estudio/foto4.jpg';
import estudio5 from '../assets/images/sobre-mi/estudio/foto5.jpg';
import CTAFinal from '../components/CTAFinal.astro';
---
<Layout title="Sobre mí">

  <!-- INTRO -->
  <section class="w-full py-16 md:py-24 px-6 bg-cream">
    <div class="max-w-5xl mx-auto flex flex-col md:flex-row items-center md:items-start gap-10 md:gap-16">

      <!-- Foto vertical con proporción fija + tarjetita -->
        <div class="relative w-72 md:w-[26rem] shrink-0 mx-auto md:mx-0">
        <div class="aspect-[3/4] rounded-[2rem] overflow-hidden shadow-lg">
          <Image
            src={retrato}
            alt="Fotógrafa de LeCapture"
            width={500}
            height={650}
            format="webp"
            quality={85}
            loading="eager"
            class="w-full h-full object-cover"
          />
        </div>
        <div class="absolute -bottom-4 -right-4 bg-cream border border-choco/20 rounded-2xl px-4 py-2.5 shadow-md rotate-[-4deg] text-center">
          <p class="text-choco font-bold text-lg leading-none">+500</p>
          <p class="text-choco/70 text-xs flex items-center justify-center gap-1">
            familias felices
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3 shrink-0" style="color: #C3CC9B;"><path d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5"/></svg>
          </p>
        </div>
      </div>

      <!-- Texto -->
      <div class="text-center md:text-left md:pt-4">
        <p class="text-forest text-xs md:text-sm font-semibold tracking-widest uppercase mb-2">
          Conóceme
        </p>
        <h1 class="font-script text-3xl md:text-5xl font-normal text-choco mb-5 relative inline-block">
          Hola, soy Candela

        </h1>
        <p class="text-choco/70 leading-relaxed mb-4 max-w-md">
          Mi cámara y yo somos inseparables desde hace más de una década. Con más de 500 familias y bebés retratados —y una formación en España que me llevó a recorrer distintos rincones de Europa—, volví mi pasión un oficio. Busco la armonía y la belleza en cada rincón, cuidando los colores, las texturas y los pequeños detalles cotidianos para que cada imagen tenga su propia magia.
        </p>
        <p class="text-choco/70 leading-relaxed max-w-md">
          Me encanta crear con mis propias manos: diseño, decoro y armo cada escenografía para que tu sesión sea irrepetible. Detrás de cada toma hay mucho más que técnica; hay horas de dedicación, sensibilidad estética y el deseo genuino de que tus recuerdos reflejen la belleza y autenticidad de tu historia.
        </p>
      </div>

    </div>
  </section>

  <!-- DETRÁS DE CÁMARA -->
  <section class="w-full py-16 md:py-24 px-6 bg-sand/30">
    <div class="max-w-5xl mx-auto">

      <p class="text-forest text-xs md:text-sm font-semibold tracking-widest uppercase text-center mb-2">
        Mi trabajo
      </p>
      <h2 class="text-2xl md:text-4xl font-semibold text-center text-choco mb-4">
        Detrás de cámara
      </h2>
      <p class="text-choco/70 text-center max-w-lg mx-auto mb-12 md:mb-16">
      Paciencia, juego y momentos espontáneos: la verdadera receta detrás de cada risa y cada recuerdo.
      </p>

      <!-- Mosaico: foto grande + 2 chicas, con altura total fija -->
      <div class="grid grid-cols-2 grid-rows-2 gap-4 md:gap-6 h-[380px] md:h-[480px]">
        <div class="row-span-2 rounded-[1.5rem] overflow-hidden shadow-md group">
          <Image
            src={detrasCamara1}
            alt="Sesión de fotos en proceso"
            width={600}
            height={800}
            format="webp"
            quality={85}
            loading="lazy"
            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
          />
        </div>
        <div class="rounded-[1.5rem] overflow-hidden shadow-md group">
          <Image
            src={detrasCamara2}
            alt="Sesión de fotos en proceso"
            width={500}
            height={380}
            format="webp"
            quality={85}
            loading="lazy"
            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
          />
        </div>
        <div class="rounded-[1.5rem] overflow-hidden shadow-md group">
          <Image
            src={detrasCamara3}
            alt="Sesión de fotos en proceso"
            width={500}
            height={380}
            format="webp"
            quality={85}
            loading="lazy"
            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
          />
        </div>
      </div>

    </div>
  </section>

  <!-- EL ESTUDIO -->
  <section class="w-full py-16 md:py-24 px-6 bg-cream">
    <div class="max-w-5xl mx-auto">

      <p class="text-forest text-xs md:text-sm font-semibold tracking-widest uppercase text-center mb-2">
        El espacio
      </p>
      <h2 class="text-2xl md:text-4xl font-semibold text-center text-choco mb-4">
        Conocé el estudio
      </h2>
      <p class="text-choco/70 text-center max-w-lg mx-auto mb-12 md:mb-16">
       Un espacio creado y pensado desde el amor para que vos, tu familia se sientan como en casa, rodeados de comodidad y calidez.
      </p>

      <!-- Carrusel horizontal con flechas -->
      <div class="relative">
        <div
          id="estudio-scroll"
          class="flex gap-5 overflow-x-auto snap-x snap-mandatory pb-4 scrollbar-hide"
        >
          {[estudio1, estudio2, estudio3, estudio4, estudio5].map((foto, i) => (
            <div class="snap-center shrink-0 w-72 md:w-96 rounded-[1.5rem] overflow-hidden shadow-md group">
              <Image
                src={foto}
                alt={`Estudio de fotografía - imagen ${i + 1}`}
                width={500}
                height={380}
                format="webp"
                quality={85}
                loading="lazy"
                class="w-full h-64 md:h-80 object-cover group-hover:scale-110 transition-transform duration-500"
              />
            </div>
          ))}
        </div>

        <!-- Degradados en ambos bordes -->
        <div class="pointer-events-none absolute top-0 left-0 h-[calc(100%-1rem)] w-16 bg-gradient-to-r from-sand/70 via-sand/25 to-transparent"></div>
        <div class="pointer-events-none absolute top-0 right-0 h-[calc(100%-1rem)] w-16 bg-gradient-to-l from-sand/70 via-sand/25 to-transparent"></div>

        <!-- Flechas -->
        <button
          id="estudio-prev"
          aria-label="Ver anterior"
          class="absolute left-0 top-1/2 -translate-y-1/2 text-choco/50 hover:text-choco text-4xl leading-none px-2 transition-colors"
        >
          ‹
        </button>
        <button
          id="estudio-next"
          aria-label="Ver siguiente"
          class="absolute right-0 top-1/2 -translate-y-1/2 text-choco/50 hover:text-choco text-4xl leading-none px-2 transition-colors"
        >
          ›
        </button>
      </div>

    </div>
  </section>

  <script>
    const scrollEl = document.getElementById('estudio-scroll');
    const nextBtn = document.getElementById('estudio-next');
    const prevBtn = document.getElementById('estudio-prev');

    nextBtn?.addEventListener('click', () => {
      scrollEl?.scrollBy({ left: 320, behavior: 'smooth' });
    });

    prevBtn?.addEventListener('click', () => {
      scrollEl?.scrollBy({ left: -320, behavior: 'smooth' });
    });
  </script>

  <!-- CTA FINAL -->
  <CTAFinal />

</Layout>
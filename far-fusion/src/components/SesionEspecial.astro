---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const todas = await getCollection('sesionesEspeciales');
const activa = todas.find((s: (typeof todas)[number]) => s.data.activa);
---

{activa && (
  <section class="w-full py-16 md:py-24 px-4 md:px-6 bg-cream">
    <div class="max-w-4xl mx-auto relative">

      <div class="bg-sand/50 rounded-[2.5rem] shadow-[0_0_0_6px_#fff8ec,0_0_0_9px_rgba(220,204,172,0.7)] overflow-hidden">
        <div class="flex flex-col md:flex-row items-center">

          <!-- Foto ovalada con etiqueta colgante -->
          <div class="relative w-full md:w-1/2 p-8 md:p-10 flex justify-center">
            <div class="relative w-64 h-64 md:w-72 md:h-72 rounded-full overflow-hidden shadow-lg rotate-[-3deg] border-8 border-cream">
              <Image
                src={activa.data.imagen}
                alt={activa.data.titulo}
                width={500}
                height={500}
                format="webp"
                quality={85}
                loading="lazy"
                class="w-full h-full object-cover"
              />
            </div>
            <!-- Etiqueta colgante -->
            <div class="absolute top-4 right-6 md:right-10 bg-cream border border-choco/20 rounded-sm px-3 py-1.5 shadow-md rotate-[8deg] text-xs text-choco font-semibold flex items-center gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 text-choco shrink-0"><path d="m17 14 3 3.3a1 1 0 0 1-.7 1.7H4.7a1 1 0 0 1-.7-1.7L7 14h-.3a1 1 0 0 1-.7-1.7L9 9h-.2A1 1 0 0 1 8 7.3L12 3l4 4.3a1 1 0 0 1-.8 1.7H15l3 3.3a1 1 0 0 1-.7 1.7H17Z"/><path d="M12 22v-3"/></svg>
              LeCapture
            </div>
          </div>

          <!-- Texto -->
          <div class="w-full md:w-1/2 p-8 md:pr-12 text-center md:text-left">
            <span class="inline-flex items-center gap-1.5 bg-forest text-cream text-sm font-semibold px-4 py-1.5 rounded-full mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 text-white shrink-0"><path d="m17 14 3 3.3a1 1 0 0 1-.7 1.7H4.7a1 1 0 0 1-.7-1.7L7 14h-.3a1 1 0 0 1-.7-1.7L9 9h-.2A1 1 0 0 1 8 7.3L12 3l4 4.3a1 1 0 0 1-.8 1.7H15l3 3.3a1 1 0 0 1-.7 1.7H17Z"/><path d="M12 22v-3"/></svg>
              Sesión especial
            </span>
            <h2 class="font-script text-2xl md:text-4xl font-normal text-choco mb-2">
              {activa.data.titulo}
            </h2>
            <p class="text-choco/70 text-base md:text-lg mb-6">
              {activa.data.subtitulo}
            </p>
            <a
          href={`https://wa.me/549XXXXXXXXXX?text=${encodeURIComponent(activa.data.whatsappTexto)}`}
          target="_blank"
          style="color: white;"
          class="inline-block bg-sage-button text-white px-7 py-3.5 rounded-full font-semibold hover:scale-105 transition-transform duration-300"
        >
          Reservar ahora
        </a>
          </div>

        </div>
      </div>

      <!-- Estrellitas decorativas sueltas -->
      <span class="hidden md:block absolute -top-4 left-10 rotate-[-15deg]">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8 text-sand"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"/><path d="M20 2v4"/><path d="M22 4h-4"/><circle cx="4" cy="20" r="2"/></svg>
      </span>
      <span class="hidden md:block absolute -bottom-4 right-16 rotate-[15deg]">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8 text-sand"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>
      </span>

    </div>
  </section>
)}
---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';

const links = [
  { href: '/', label: 'Home' },
  { href: '/sobre-mi', label: 'Sobre mí' },
  { href: '/sesiones', label: 'Sesiones' },
  { href: '/contacto', label: 'Contacto' },
];
---
<header class="w-full py-4 px-6 flex items-center justify-between bg-white shadow-sm">
<a href="/">
<Image
  src={logo}
  alt="LeCapture Fotografía"
  width={160}
  height={60}
  format="webp"
  quality={90}
  class="h-12 md:h-16 w-auto"
/>
</a>

  <!-- Menú desktop -->
<nav class="hidden md:flex gap-8">
  {links.map((link) => (
    <a href={link.href} class="text-lg md:text-xl text-choco hover:scale-110 transition-all duration-300 inline-block">
      {link.label}
    </a>
  ))}
</nav>

  <!-- Botón hamburguesa (mobile) -->
  <button id="menu-btn" class="md:hidden text-2xl" aria-label="Abrir menú">
    ☰
  </button>
</header>

<!-- Menú mobile desplegable -->
<nav id="mobile-menu" class="hidden md:hidden flex-col bg-white px-6 pb-4 gap-4">
  {links.map((link) => (
    <a href={link.href} class="text-lg text-choco py-2 border-b border-gray-100">
      {link.label}
    </a>
  ))}
</nav>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    menu?.classList.toggle('flex');
  });
</script>
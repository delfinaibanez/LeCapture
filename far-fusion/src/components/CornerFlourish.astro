---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 120 120"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- Tallo curvo principal -->
  <path
    d="M8 112 C 20 90, 18 65, 32 48 C 42 36, 40 24, 30 20"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
  />

  <!-- Hongo grande -->
  <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M20 18 C 20 8, 40 8, 40 18 C 40 22, 20 22, 20 18Z" />
    <path d="M27 22 L 27 34" />
    <circle cx="24" cy="13" r="1.2" fill="currentColor" stroke="none" />
    <circle cx="34" cy="15" r="1" fill="currentColor" stroke="none" />
  </g>

  <!-- Hongo chico -->
  <g stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
    <path d="M42 40 C 42 34, 54 34, 54 40 C 54 43, 42 43, 42 40Z" />
    <path d="M46 43 L 46 50" />
  </g>

  <!-- Flor 1 -->
  <g stroke="currentColor" stroke-width="1.3" stroke-linecap="round">
    <circle cx="15" cy="60" r="4" />
    <circle cx="9" cy="57" r="3.5" />
    <circle cx="9" cy="64" r="3.5" />
    <circle cx="21" cy="57" r="3.5" />
    <circle cx="21" cy="64" r="3.5" />
    <circle cx="15" cy="60" r="1.5" fill="currentColor" stroke="none" />
  </g>

  <!-- Hojas -->
  <path d="M32 75 C 24 73, 18 78, 22 85 C 26 90, 34 85, 32 75Z" stroke="currentColor" stroke-width="1.3" />
  <path d="M22 95 C 14 93, 8 98, 12 105 C 16 110, 24 105, 22 95Z" stroke="currentColor" stroke-width="1.3" />

  <!-- Flor 2, más chica, cerca de la base -->
  <g stroke="currentColor" stroke-width="1.2" stroke-linecap="round">
    <circle cx="38" cy="102" r="3" />
    <circle cx="33" cy="100" r="2.6" />
    <circle cx="33" cy="105" r="2.6" />
    <circle cx="43" cy="100" r="2.6" />
    <circle cx="43" cy="105" r="2.6" />
    <circle cx="38" cy="102" r="1.2" fill="currentColor" stroke="none" />
  </g>
</svg>